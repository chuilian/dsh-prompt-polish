{
  "name": "dsh-prompt-polish",
  "version": "1.0.0",
  "private": true,
  "description": "One-click prompt polishing in the DSH Web composer: a sparkle button that rewrites the draft into a professional, unambiguous, executable prompt and shows a before/after comparison. · DSH 输入框提示词美化：点一下星标按钮，草稿就被改写成专业、准确、可执行的提示词，并给出前后对比。",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/host/*.test.js\" \"tests/client/*.test.js\"",
    "test:host": "node --test --test-concurrency=1 \"tests/host/*.test.js\"",
    "test:client": "node --test --test-concurrency=1 \"tests/client/*.test.js\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "composer",
    "web-ui"
  ],
  "license": "MIT"
}
